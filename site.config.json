import fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import MarkdownIt from 'markdown-it';
import MathJax from 'mathjax';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const root = path.resolve(__dirname, '..');
const dist = path.join(root, 'dist');
const config = JSON.parse(await fs.readFile(path.join(root, 'site.config.json'), 'utf8'));

const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: false,
  breaks: false
});

await MathJax.init({
  // Keep the Node configuration deliberately small and stable.
  // `input/tex` already contains the standard TeX/LaTeX packages
  // (including AMS support and autoload for many extensions).
  loader: {
    load: ['input/tex', 'output/svg']
  },
  tex: {
    processEscapes: true
  },
  svg: {
    fontCache: 'local'
  },
  startup: {
    typeset: false
  }
});

const mathCache = new Map();

function escapeHtml(value) {
  return String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

function stripHtml(value) {
  return String(value)
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .trim();
}

function cleanTicketTitle(markdown) {
  const match = markdown.match(/^##\s+(.+)$/m);
  if (!match) return 'Билет';
  return match[1].replace(/\$([^$]+)\$/g, '$1').replace(/[*_`]/g, '').trim();
}

function splitTickets(source) {
  const marker = /<a\s+id=["']ticket-(\d+)["']\s*><\/a>/gi;
  const matches = [...source.matchAll(marker)];
  if (!matches.length) return { intro: source, tickets: [] };

  const intro = source.slice(0, matches[0].index).trim();
  const tickets = matches.map((match, index) => {
    const start = match.index + match[0].length;
    const end = index + 1 < matches.length ? matches[index + 1].index : source.length;
    const raw = source.slice(start, end).trim();
    const cleanedForCopy = raw
      .replace(/\n?\[↑\s*К содержанию\]\([^\n]+\)\s*/gi, '\n')
      .replace(/\n?---\s*$/g, '')
      .trim();

    return {
      number: Number(match[1]),
      id: `ticket-${match[1]}`,
      raw,
      copySource: cleanedForCopy,
      title: cleanTicketTitle(raw)
    };
  });

  return { intro, tickets };
}

function tokenizeMath(source) {
  const tokens = [];
  const add = (tex, display) => {
    const key = `MATHPLACEHOLDER${tokens.length}TOKEN`;
    tokens.push({ key, tex: tex.trim(), display });
    return key;
  };

  let text = source;

  // GitHub-style fenced math blocks.
  text = text.replace(/```math\s*\n([\s\S]*?)```/gi, (_, tex) => `\n\n${add(tex, true)}\n\n`);

  // Display TeX forms.
  text = text.replace(/\\\[([\s\S]*?)\\\]/g, (_, tex) => add(tex, true));
  text = text.replace(/\$\$([\s\S]*?)\$\$/g, (_, tex) => add(tex, true));

  // Inline \(...\).
  text = text.replace(/\\\(([^\n]*?)\\\)/g, (_, tex) => add(tex, false));

  // Protect inline code before parsing $...$.
  const codeTokens = [];
  text = text.replace(/`([^`\n]+)`/g, (full) => {
    const key = `CODEPLACEHOLDER${codeTokens.length}TOKEN`;
    codeTokens.push({ key, full });
    return key;
  });

  // Inline $...$ math. The repository uses dollar delimiters intentionally.
  text = text.replace(/(^|[^\\$])\$(?!\$)([^\n$]+?)(?<!\\)\$/g, (full, prefix, tex) => `${prefix}${add(tex, false)}`);

  for (const token of codeTokens) {
    text = text.replaceAll(token.key, token.full);
  }

  return { text, tokens };
}

async function renderMath(tex, display) {
  const cacheKey = `${display ? 'd' : 'i'}:${tex}`;
  if (mathCache.has(cacheKey)) return mathCache.get(cacheKey);

  try {
    const node = await MathJax.tex2svgPromise(tex, {
      display,
      em: 16,
      ex: 8,
      containerWidth: 1100
    });
    const adaptor = MathJax.startup.adaptor;
    const svg = typeof adaptor.serializeXML === 'function'
      ? adaptor.serializeXML(node)
      : adaptor.outerHTML(node);
    const html = display
      ? `<div class="math-display">${svg}</div>`
      : `<span class="math-inline">${svg}</span>`;
    mathCache.set(cacheKey, html);
    return html;
  } catch (error) {
    const safe = escapeHtml(tex);
    const title = escapeHtml(error?.message ?? 'MathJax render error');
    const html = `<span class="math-error" title="${title}">${safe}</span>`;
    mathCache.set(cacheKey, html);
    return html;
  }
}

async function renderMarkdown(source) {
  const { text, tokens } = tokenizeMath(source);
  let html = md.render(text);

  for (const token of tokens) {
    html = html.replaceAll(token.key, await renderMath(token.tex, token.display));
  }

  return html;
}

function rewriteArticleLinks(html) {
  // The generated HTML lives at repository root in dist/, exactly like source MD,
  // so existing ./assets/... paths keep working. We only normalize markdown links
  // to other configured markdown articles when possible.
  const markdownItems = config.groups
    .flatMap((group) => group.items)
    .filter((item) => item.type === 'markdown');

  for (const item of markdownItems) {
    const encoded = item.source.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    html = html.replace(new RegExp(`href=["']\\.?\\/?${encoded}["']`, 'g'), `href="${item.slug}.html"`);
  }
  return html;
}

function pageHead(title, description = '') {
  return `<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="${escapeHtml(description)}">
  <title>${escapeHtml(title)}</title>
  <link rel="stylesheet" href="./site-assets/site.css">
</head>`;
}

function siteHeader() {
  return `<header class="site-shell site-header">
    <a class="brand" href="./index.html" aria-label="На главную">
      <span class="brand-mark">N</span>
      <span>notes</span>
    </a>
    <a class="header-link" href="https://github.com/krangras/notes">GitHub ↗</a>
  </header>`;
}

function buildIndex() {
  const groups = config.groups.map((group) => {
    const cards = group.items.map((item) => {
      const href = item.type === 'markdown' ? `./${item.slug}.html` : `./${encodeURI(item.source)}`;
      const target = item.type === 'pdf' ? ' target="_blank" rel="noopener"' : '';
      return `<a class="doc-card" data-doc-card href="${href}"${target}>
        <div class="doc-card-top">
          <div>
            <h3>${escapeHtml(item.title)}</h3>
            <p>${escapeHtml(item.subtitle ?? '')}</p>
          </div>
          <span class="badge">${escapeHtml(item.badge ?? item.type)}</span>
        </div>
        <span class="card-arrow">↗</span>
      </a>`;
    }).join('\n');

    return `<section class="doc-group" data-doc-group>
      <div class="group-heading">
        <h2>${escapeHtml(group.title)}</h2>
        <p>${escapeHtml(group.description ?? '')}</p>
      </div>
      <div class="doc-grid">${cards}</div>
    </section>`;
  }).join('\n');

  return `${pageHead(config.siteTitle, config.siteSubtitle)}
<body>
  ${siteHeader()}
  <main class="site-shell">
    <section class="hero">
      <p class="eyebrow">Личный справочник</p>
      <h1>${escapeHtml(config.siteTitle)}</h1>
      <p>${escapeHtml(config.siteSubtitle)}</p>
      <div class="search-wrap">
        <input class="catalog-search" data-catalog-search type="search" placeholder="Найти дисциплину или материал…" aria-label="Поиск материалов">
      </div>
    </section>
    <section class="catalog">${groups}</section>
  </main>
  <footer class="site-shell site-footer">Статический справочник · GitHub Pages</footer>
  <script src="./site-assets/site.js" defer></script>
</body>
</html>`;
}

async function buildArticle(item) {
  const sourcePath = path.join(root, item.source);
  const source = await fs.readFile(sourcePath, 'utf8');
  const { intro, tickets } = splitTickets(source);

  let introHtml = await renderMarkdown(intro);
  introHtml = rewriteArticleLinks(introHtml);

  const ticketHtml = [];
  for (const ticket of tickets) {
    let rendered = await renderMarkdown(ticket.raw);
    rendered = rewriteArticleLinks(rendered);

    ticketHtml.push(`<section class="ticket" id="${ticket.id}" data-ticket>
      <div class="ticket-actions"><button class="copy-ticket" type="button" data-copy-ticket>Копировать билет</button></div>
      ${rendered}
      <textarea class="ticket-source" data-ticket-source aria-hidden="true" tabindex="-1">${escapeHtml(ticket.copySource)}</textarea>
    </section>`);
  }

  const toc = tickets.length
    ? `<aside class="toc" aria-label="Билеты">
        <p class="toc-title">Билеты</p>
        <nav class="toc-list">
          ${tickets.map((ticket) => `<a class="toc-link" href="#${ticket.id}">${escapeHtml(ticket.title)}</a>`).join('\n')}
        </nav>
      </aside>`
    : '';

  const layoutClass = tickets.length ? 'article-layout' : 'article-layout article-layout-single';
  const body = `${introHtml}${ticketHtml.join('\n')}`;
  const description = item.subtitle || item.title;

  return `${pageHead(`${item.title} — notes`, description)}
<body>
  <div class="reading-progress" data-reading-progress></div>
  ${siteHeader()}
  <header class="site-shell article-header">
    <a class="back-link" href="./index.html">← Все материалы</a>
    <h1>${escapeHtml(item.title)}</h1>
    <p>${escapeHtml(item.subtitle ?? '')}</p>
  </header>
  <main class="${layoutClass}">
    ${toc}
    <article class="article-body">${body}</article>
  </main>
  <script src="./site-assets/site.js" defer></script>
</body>
</html>`;
}

async function copyIfExists(sourcePath, destinationPath) {
  try {
    await fs.access(sourcePath);
  } catch {
    return false;
  }
  await fs.cp(sourcePath, destinationPath, { recursive: true });
  return true;
}

async function build() {
  await fs.rm(dist, { recursive: true, force: true });
  await fs.mkdir(dist, { recursive: true });
  await fs.mkdir(path.join(dist, 'site-assets'), { recursive: true });

  await fs.copyFile(path.join(root, 'site/assets/site.css'), path.join(dist, 'site-assets/site.css'));
  await fs.copyFile(path.join(root, 'site/assets/site.js'), path.join(dist, 'site-assets/site.js'));

  await copyIfExists(path.join(root, 'assets'), path.join(dist, 'assets'));

  const allItems = config.groups.flatMap((group) => group.items);

  for (const item of allItems) {
    const sourcePath = path.join(root, item.source);
    try {
      await fs.access(sourcePath);
    } catch {
      console.warn(`[skip] Missing source: ${item.source}`);
      continue;
    }

    if (item.type === 'markdown') {
      const article = await buildArticle(item);
      await fs.writeFile(path.join(dist, `${item.slug}.html`), article, 'utf8');
      console.log(`[article] ${item.source} -> ${item.slug}.html`);
    } else {
      await fs.copyFile(sourcePath, path.join(dist, item.source));
      console.log(`[asset] ${item.source}`);
    }
  }

  // Keep any additional root PDFs available even before they are added to the catalog.
  const rootEntries = await fs.readdir(root, { withFileTypes: true });
  for (const entry of rootEntries) {
    if (!entry.isFile() || !entry.name.toLowerCase().endsWith('.pdf')) continue;
    await fs.copyFile(path.join(root, entry.name), path.join(dist, entry.name));
  }

  await fs.writeFile(path.join(dist, 'index.html'), buildIndex(), 'utf8');
  await fs.writeFile(path.join(dist, '.nojekyll'), '', 'utf8');
  console.log(`Built ${dist}`);
}

try {
  await build();
} finally {
  MathJax.done();
}
